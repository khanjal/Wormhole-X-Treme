[I][I][I][I][I][I][I][S:A][I][I]
[I][I][I][I][I][I][I][S:IA][I][I]

# Number of ticks to wait before activating each # of the woosh. 1 tick = ~50ms
WOOSH_TICKS = 3;
# Number of ticks to wait before activating each # of the lights. 1 tick = ~50ms
LIGHT_TICKS = 2;

# Materials are not set here. A gate's appearance comes from its material group in
# config.yml, chosen by the material the frame is actually built from: build this shape
# in obsidian for a Standard gate, in lapis for an Atlantis one.
#
# A shape may still pin a material if this geometry genuinely requires one, by setting
# PORTAL_MATERIAL, IRIS_MATERIAL, STARGATE_MATERIAL or ACTIVE_MATERIAL here. An explicit
# value outranks the material group, so use it only when the shape really does need to
# look a particular way regardless of palette.

# Redstone activated is the parameter to allow redstone to/from redstone locations.
REDSTONE_ACTIVATED=FALSE

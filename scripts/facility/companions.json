{
  "about": "Companion plugins for run-facility.js --with, pinned by version and SHA-256. Each is read from the plugin cache first (--plugin-cache: its <minecraft version> folder, then any/), then from .local-server/companions/, and only then downloaded from `url`, an official release source (Modrinth, GitHub releases, and for Dynmap 3.8 dynmap.us, the Dynmap project's own build server). Never SpigotMC: its downloads are not scriptable. A build with no url would be cache-only and say where it comes from. `versions` lists the Minecraft versions a build is pinned for, or * for every one.",
  "sets": {
    "permissions": ["luckperms", "vault"],
    "regions": ["worldedit", "worldguard"],
    "via": ["viaversion", "viabackwards"],
    "maps": ["dynmap", "bluemap", "squaremap", "pl3xmap"]
  },
  "companions": {
    "viaversion": {
      "plugin": "ViaVersion",
      "why": "join from other client versions",
      "builds": [
        {
          "versions": "*", "version": "5.12.0", "file": "ViaVersion-5.12.0.jar", "size": 6503775,
          "sha256": "c4d512fa9760fa41d17abaedde12aa1f4c9bde920d0a992fe0fc016962f126be",
          "source": "Modrinth (viaversion)", "url": "https://cdn.modrinth.com/data/P1OZGk5p/versions/FaishMnD/ViaVersion-5.12.0.jar"
        }
      ]
    },
    "viabackwards": {
      "plugin": "ViaBackwards",
      "requires": ["viaversion"],
      "why": "join from older client versions",
      "builds": [
        {
          "versions": "*", "version": "5.12.0", "file": "ViaBackwards-5.12.0.jar", "size": 1430897,
          "sha256": "f902f7da7eb99e8bfaf461f80283c4e2750b7d9727e6b508ea4bb9163f55b1db",
          "source": "Modrinth (viabackwards)", "url": "https://cdn.modrinth.com/data/NpvuJQoq/versions/SxGhdsPK/ViaBackwards-5.12.0.jar"
        }
      ]
    },
    "dynmap": {
      "plugin": "dynmap",
      "why": "the web map the #236 markers are drawn on",
      "builds": [
        {
          "versions": "1.20.4", "version": "3.7-beta-8", "file": "Dynmap-3.7-beta-8-spigot.jar", "size": 11659463,
          "sha256": "87c6035c2cb73bf22fc34ca738cb21a2db89ab5f30bd1071cd8090802a1c78bc",
          "source": "Modrinth (dynmap)", "url": "https://cdn.modrinth.com/data/fRQREgAc/versions/ImNNT17B/Dynmap-3.7-beta-8-spigot.jar"
        },
        {
          "versions": "1.21.11", "version": "3.8", "file": "Dynmap-3.8-spigot.jar", "size": 11819070,
          "sha256": "4771dbe8cbb3ec6a3ee080141361de6d822eac55b55aad7c9e5de031423a6dd7",
          "source": "dynmap.us, the Dynmap project's own build server (the same bytes as CurseForge file 7460127; Modrinth has 3.8 for Forge and Fabric only, Dynmap's GitHub releases stop at 3.3, and SpigotMC resource 274 is not scriptable)",
          "url": "https://dynmap.us/builds/dynmap/Dynmap-3.8-spigot.jar"
        }
      ],
      "unsupported": [
        {
          "from": "26", "why": "no Dynmap build supports 26.x: its newest version helper is 1.21.11, and on 26.1.2 it disables itself (bukkit version incompatible). Run the Dynmap cells on 1.21.11."
        }
      ]
    },
